<Project>
  <!-- Keep the tag's compile-time API and the complete, publicly available IKVM runtime together. -->
  <ItemGroup>
    <PackageReference Include="IKVM11" Version="8.15.5" ExcludeAssets="runtime" />
    <PackageReference Include="IKVM" Version="8.15.0" IncludeAssets="runtime" />
  </ItemGroup>
</Project>
