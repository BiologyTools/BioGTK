<Project>
  <!-- Use the public AForgeBio version when building BioLib from source. -->
  <ItemGroup Condition="'$(BioGTKUsePublicPackages)' == 'true'">
    <PackageReference Update="AForgeBio">
      <Version Condition="'%(PackageReference.Version)' == '2.5.1'">2.5.0</Version>
    </PackageReference>
  </ItemGroup>
  <!-- Supply the native libraries for the selected Mac alongside the IKVM11 assemblies. -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'osx-arm64' Or '$(RuntimeIdentifier)' == 'osx-x64'">
    <PackageReference Include="IKVM.Image.runtime.$(RuntimeIdentifier)" Version="8.15.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'BioGTK' And '$(BioGTKMacBioLibProject)' != ''">
    <PackageReference Remove="BioLib" />
    <ProjectReference Include="$(BioGTKMacBioLibProject)" />
  </ItemGroup>
  <Choose>
    <When Condition="'$(MSBuildProjectName)' == 'BioGTKApp' And ('$(RuntimeIdentifier)' == 'osx-arm64' Or '$(RuntimeIdentifier)' == 'osx-x64')">
      <PropertyGroup>
        <DefineConstants>$(DefineConstants);BIOGTK_MAC_BUNDLE</DefineConstants>
      </PropertyGroup>
      <ItemGroup>
        <Compile Include="$(MSBuildThisFileDirectory)GtkBundleStartup.cs" />
      </ItemGroup>
    </When>
  </Choose>
</Project>
